{
  "schema_version": 1,
  "purpose": "Independent pre-registered design; evaluator-only expected outcomes must not enter agent prompts.",
  "skills": {
    "join": {
      "name": "recording-joins",
      "description": "Join recording metadata to measured responses or select responses by cell type. Does not govern file metadata or table-schema inspection.",
      "body": "Join recordings and measurements using recording_id, never basename. Basenames are not globally unique. Filter cell_type on recordings. Check the joined row count against measurements for the selected recording IDs. Return every measurement unless the current task requests aggregation.",
      "targets": [
        "database"
      ]
    },
    "aggregate": {
      "name": "population-response",
      "description": "Compute an analysis population response using the project weighting convention. Does not govern retrieval of individual measurements or file inspection.",
      "body": "For population summaries, average value within each recording_id, then average those recording means with equal weight. Report recording count and within-recording means. If the scientist explicitly requests a different estimand such as the raw row mean, honor that request and label it; do not silently apply this default.",
      "targets": [
        "database"
      ]
    },
    "fit": {
      "name": "per-cell-linear-fit",
      "description": "Fit linear response coefficients per cell using this fitting script. Not applicable to inspecting, copying, or listing the script.",
      "body": "Fit y = intercept + slope*x separately for each cell using ordinary least squares. Include an intercept. Do not pool cell observations and do not force an origin. Report each cell slope, intercept, and observation count.",
      "targets": [
        "fit_script"
      ]
    },
    "plot": {
      "name": "population-response-plot",
      "description": "Plot population response curves from this dataset with the analysis averaging and display conventions. Not for fitting coefficients or file inventory.",
      "body": "At each x, first average repeats within cell, then average cell means equally. Use a logarithmic x axis, a linear y axis, and retain the raw positive x values in the plotted coordinates. Label axes stimulus and response. Plot response curves only; do not add a fitted curve unless requested. Explicit scientist display requests override these defaults.",
      "targets": [
        "plot_dataset"
      ]
    },
    "export": {
      "name": "analysis-export-naming",
      "description": "Name newly exported result artifacts for this analysis and prevent accidental overwrite. Not for reading or listing existing artifacts.",
      "body": "Create the requested output within its designated directory using {artifact_id}__{purpose}.json. Normalize purpose to lowercase ASCII words joined by hyphens. Never overwrite an existing result: if the base filename exists use {artifact_id}__{purpose}__{run_id}.json, and fail visibly if that also exists.",
      "targets": [
        "export_directory"
      ]
    }
  },
